# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=@your_channel
ADMIN_USER_ID=123456789,987654321
POST_INTERVAL_MINUTES=30

# Инструкция:
# 1. Скопируйте этот файл и переименуйте в .env
# 2. Замените значения на реальные
# 3. BOT_TOKEN получите у @BotFather
# 4. ADMIN_USER_ID - ваш Telegram ID (узнать: напишите боту /start)
